# ============================================================
# DraftMind Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Supabase (REQUIRED) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from: supabase status>
SUPABASE_SERVICE_ROLE_KEY=<from: supabase status>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- App (REQUIRED) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Encryption (REQUIRED) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=<32-byte base64 key for AES-256-GCM encryption of provider API keys>

# --- Deployment ---
DEPLOYMENT_TARGET=local

# --- Skip env validation (set true only for local dev) ---
SKIP_ENV_VALIDATION=false

# --- Email (OPTIONAL — emails skipped silently if not set) ---
# Sign up at https://resend.com to get an API key
RESEND_API_KEY=
EMAIL_FROM=DraftMind <noreply@draftmind.app>

# --- LangSmith (OPTIONAL — AI observability & monitoring) ---
# Sign up at https://smith.langchain.com to get an API key
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=draftmind
LANGCHAIN_TRACING_V2=true

# --- Supabase Webhook (OPTIONAL — only needed if using Supabase webhooks) ---
# Generate a random secret and set the same value in your Supabase webhook config
SUPABASE_WEBHOOK_SECRET=your-webhook-secret
